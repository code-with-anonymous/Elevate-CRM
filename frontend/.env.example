# ─────────────────────────────────────────────────────────────────────────────
# ElevateCRM — frontend environment
# Copy to .env for local dev. On Vercel, set these in Project → Settings →
# Environment Variables (they are baked in at BUILD time, so changing one
# requires a redeploy, not just a restart).
#
# Everything here ends up in the client bundle. Never put a secret in a VITE_*
# variable — assume anyone can read them.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the API, including the /api suffix and NO trailing slash.
# Local:      http://localhost:5000/api
# Production: https://elevate-crm-4p49.onrender.com/api   <- the deployed API
#
# Point this at the Render URL even for local frontend work unless you are also
# running the backend locally. apiBaseUrl.ts refuses to boot a production build
# that still says localhost — there, localhost is the visitor's own machine.
VITE_API_BASE_URL=https://elevate-crm-4p49.onrender.com/api

# Google OAuth client id. REQUIRED — main.tsx hands this straight to
# GoogleOAuthProvider, and `undefined` breaks the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# TanStack Query devtools panel. Leave false in production.
VITE_ENABLE_DEVTOOLS=false

# ── Optional ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=ElevateCRM
VITE_APP_VERSION=1.0.0
VITE_USE_MOCK_DATA=false

# Idle session handling, in milliseconds.
VITE_SESSION_TIMEOUT_MS=1800000
VITE_SESSION_WARNING_MS=120000
