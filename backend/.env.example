# ─────────────────────────────────────────────────────────────────────────────
# ElevateCRM — backend environment
# Copy to .env for local dev. On Render, set these in Service → Environment.
#
# The three marked REQUIRED are validated in config/env.js and the process
# throws on boot if any is missing — deliberate, so a misconfigured deploy fails
# loudly at startup instead of 500ing on the first login.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/elevatecrm

# ── DNS (optional — local networks only) ─────────────────────────────────────
# A mongodb+srv:// URI needs an SRV record lookup. Many consumer ISP routers
# proxy DNS and answer A/TXT queries but return NODATA for SRV, so the driver
# fails with `querySrv ENODATA _mongodb._tcp.<cluster>` on an otherwise healthy
# connection.
#
# config/db.js detects that exact error and retries on public resolvers
# automatically, so you normally need nothing here. Uncomment to pin the
# resolver and skip the failed first attempt on a network you know is affected.
# Not needed on Render.
# DNS_SERVERS=1.1.1.1,8.8.8.8
#
# Set to false to disable the automatic retry and fail fast instead.
# DNS_SRV_FALLBACK=true

# Use long random values — e.g. `openssl rand -base64 48`.
# These MUST differ from each other: reusing one secret means a refresh token
# would validate as an access token.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Do NOT set PORT on Render — the platform injects it.
PORT=5000

# Origin of the frontend. Drives both CORS and the links in outgoing emails.
# This project in production: https://elevate-crm-ai.vercel.app  (no trailing slash —
# the CORS whitelist compares origins exactly)
CLIENT_URL=http://localhost:5173

# ── Cookie policy ────────────────────────────────────────────────────────────
# TRUE when the API and app are on different registrable domains
# (*.vercel.app + *.onrender.com). Sets SameSite=None; Secure on the refresh
# cookie, without which the browser refuses to send it cross-site and every
# session dies ~15 minutes after login.
#
# FALSE if both sit on one domain (app.example.com + api.example.com) — then
# SameSite=Lax applies, which is simpler and stricter. Prefer that if you can.
CROSS_SITE_COOKIES=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Let Vercel preview deployments (*.vercel.app) reach the API. Handy while
# iterating; turn it off once this holds data you care about, since it trusts
# every project hosted on vercel.app.
ALLOW_VERCEL_PREVIEWS=false

# Extra allowed origins, comma-separated. e.g. https://staging.example.com
EXTRA_CORS_ORIGINS=

# ── Tokens ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ── Email — Brevo SMTP ───────────────────────────────────────────────────────
# Optional. Absent, the service logs emails to the console instead of sending,
# which is fine locally but means invitations and verification links go nowhere
# in production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set this. The fallback in config/env.js has a typo (mail.com, not gmail.com).
EMAIL_FROM=

# ── Security ─────────────────────────────────────────────────────────────────
# 12 is a reasonable cost. Raising it slows every login and registration.
BCRYPT_ROUNDS=12

# ── Google Gemini (optional) ─────────────────────────────────────────────────
# Powers the AI lead summary and email drafting on POST /api/leads/:id/ai-*.
# Get a key at https://aistudio.google.com/apikey
#
# Leave blank and the server still boots — those two routes just answer
# 503 AI_NOT_CONFIGURED and the rest of the API is untouched. There is no
# heuristic fallback on purpose: a made-up risk score looks real and reps act
# on it, so a clean error is the honest failure.
#
# This is a server-only secret. Never mirror it into a VITE_ variable — the
# frontend calls our own /api/leads/:id/ai-* routes, never Google directly.
GEMINI_API_KEY=

# Override only to move off the default. Confirm the replacement lists
# generateContent in supportedGenerationMethods first:
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash
