# ─────────────────────────────────────────────────────────────────────────────
# ElevateCRM — backend environment
# Copy to .env for local dev. On Render, set these in Service → Environment.
#
# The three marked REQUIRED are validated in config/env.js and the process
# throws on boot if any is missing — deliberate, so a misconfigured deploy fails
# loudly at startup instead of 500ing on the first login.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/elevatecrm

# Use long random values — e.g. `openssl rand -base64 48`.
# These MUST differ from each other: reusing one secret means a refresh token
# would validate as an access token.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Do NOT set PORT on Render — the platform injects it.
PORT=5000

# Origin of the frontend. Drives both CORS and the links in outgoing emails.
# Production: https://<your-app>.vercel.app
CLIENT_URL=http://localhost:5173

# ── Cookie policy ────────────────────────────────────────────────────────────
# TRUE when the API and app are on different registrable domains
# (*.vercel.app + *.onrender.com). Sets SameSite=None; Secure on the refresh
# cookie, without which the browser refuses to send it cross-site and every
# session dies ~15 minutes after login.
#
# FALSE if both sit on one domain (app.example.com + api.example.com) — then
# SameSite=Lax applies, which is simpler and stricter. Prefer that if you can.
CROSS_SITE_COOKIES=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Let Vercel preview deployments (*.vercel.app) reach the API. Handy while
# iterating; turn it off once this holds data you care about, since it trusts
# every project hosted on vercel.app.
ALLOW_VERCEL_PREVIEWS=false

# Extra allowed origins, comma-separated. e.g. https://staging.example.com
EXTRA_CORS_ORIGINS=

# ── Tokens ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ── Email — Brevo SMTP ───────────────────────────────────────────────────────
# Optional. Absent, the service logs emails to the console instead of sending,
# which is fine locally but means invitations and verification links go nowhere
# in production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set this. The fallback in config/env.js has a typo (mail.com, not gmail.com).
EMAIL_FROM=

# ── Security ─────────────────────────────────────────────────────────────────
# 12 is a reasonable cost. Raising it slows every login and registration.
BCRYPT_ROUNDS=12
