backend/node_modules/
backend/.env
backend/uploads/
backend/logs/
backend/*.log

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Build & Coverage
# =========================
coverage/

# =========================
# Environment
# =========================
.env
.env.*

# Keep example env files
!.env.example
!frontend/.env.example
!backend/.env.example
node_modules

# =========================
# Testing
# =========================
# Jest coverage is already covered by the `coverage/` rule above.

# Playwright HTML report (regenerated by every run)
playwright-report/

# Playwright traces, screenshots, videos — and, in e2e/.artifacts, the API log.
# That log contains real email-verification tokens printed by the dev mailer, so
# it must never be committed.
e2e/.artifacts/
test-results/
frontend/test-results/
